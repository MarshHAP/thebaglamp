<section class="page-shell page-shell--narrow"><h1 class="page-shell__title">Reset Password</h1>
{%- form 'reset_customer_password', class: 'checkout__form' -%}
  {%- if form.errors -%}<p class="checkout__error">{{ form.errors | default_errors }}</p>{%- endif -%}
  <label>New password <input type="password" name="customer[password]" required></label>
  <label>Confirm password <input type="password" name="customer[password_confirmation]" required></label>
  <button class="btn btn--primary" type="submit">Reset Password</button>
{%- endform -%}</section>
