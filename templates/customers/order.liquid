<section class="page-shell page-shell--narrow" aria-labelledby="order-title">
  <h1 class="page-shell__title" id="order-title">Order {{ order.name }}</h1>
  <p>Placed {{ order.created_at | date: '%d %B %Y' }} · {{ order.fulfillment_status_label }}</p>
  <ul class="checkout__items">
    {%- for line_item in order.line_items -%}<li><span>{{ line_item.title }} × {{ line_item.quantity }}</span><span>{{ line_item.final_line_price | money }}</span></li>{%- endfor -%}
  </ul>
  <dl class="cart__totals">
    <div><dt>Subtotal</dt><dd>{{ order.line_items_subtotal_price | money }}</dd></div>
    {%- if order.total_discounts > 0 -%}<div class="cart__totals-discount"><dt>Discounts</dt><dd>−{{ order.total_discounts | money }}</dd></div>{%- endif -%}
    <div><dt>Delivery</dt><dd>{{ order.shipping_price | money }}</dd></div>
    <div class="cart__totals-total"><dt>Total</dt><dd>{{ order.total_price | money }}</dd></div>
  </dl>
  <p><a href="{{ routes.account_url }}">Back to my account</a></p>
</section>
