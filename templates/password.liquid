{%- layout none -%}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ shop.name }}</title>
  <link href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;1,400&family=Nunito+Sans:wght@400;700;900&display=swap" rel="stylesheet">
  {{ 'styles.css' | asset_url | stylesheet_tag }}
  {{ content_for_header }}
</head>
<body class="template-password">
  <section class="password-page">
    <p class="section-heading__eyebrow">Coming soon</p>
    <h1 class="cover__title" style="color:#000">{{ shop.name }}</h1>
    <p class="cover__subtitle" style="color:#000"><em>The heart-shaped bag light that keeps you safe, inside and out.</em></p>
    {%- if shop.password_message != blank -%}<p>{{ shop.password_message }}</p>{%- endif -%}
    {%- form 'storefront_password', class: 'footer-signup' -%}
      <label class="show-for-sr" for="password">Password</label>
      <input class="footer-signup__input" id="password" type="password" name="password" placeholder="Password">
      <button class="footer-signup__btn" type="submit">Enter</button>
      {%- if form.errors -%}<p class="checkout__error">{{ form.errors | default_errors }}</p>{%- endif -%}
    {%- endform -%}
  </section>
</body>
</html>
