<section class="page-shell page-shell--narrow" aria-labelledby="blog-title">
  <h1 class="page-shell__title" id="blog-title">{{ blog.title }}</h1>
  {%- paginate blog.articles by 10 -%}
  <ul class="article-list">
    {%- for article in blog.articles -%}
      <li><a href="{{ article.url }}"><h2 class="h3">{{ article.title }}</h2></a><p class="plp-toolbar__count">{{ article.published_at | date: '%d %B %Y' }}</p><p>{{ article.excerpt_or_content | strip_html | truncatewords: 40 }}</p></li>
    {%- endfor -%}
  </ul>
  {%- if paginate.pages > 1 -%}<div class="pagination">{{ paginate | default_pagination }}</div>{%- endif -%}
  {%- endpaginate -%}
</section>
