<section class="page-shell" aria-labelledby="search-title">
  <h1 class="page-shell__title" id="search-title">Search</h1>
  <form action="{{ routes.search_url }}" method="get" role="search" class="search-page__form">
    <label class="show-for-sr" for="search-page-input">Search</label>
    <input class="search-bar__input" id="search-page-input" type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search {{ shop.name }}">
    <button class="btn btn--primary" type="submit">Search</button>
  </form>
  {%- if search.performed -%}
    <p class="plp-toolbar__count">{{ search.results_count }} results for “{{ search.terms | escape }}”</p>
    {%- paginate search.results by 12 -%}
    <ul class="product-grid">
      {%- for item in search.results -%}
        <li>{%- if item.object_type == 'product' -%}{% render 'product-card', product: item %}{%- else -%}<a class="product-card" href="{{ item.url }}"><p class="product-card__name">{{ item.title }}</p></a>{%- endif -%}</li>
      {%- endfor -%}
    </ul>
    {%- if paginate.pages > 1 -%}<div class="pagination">{{ paginate | default_pagination }}</div>{%- endif -%}
    {%- endpaginate -%}
  {%- endif -%}
</section>
