{%- if settings.show_announcement -%}
<div class="site-updates" id="site-updates">
  <p class="site-updates__text">{{ section.settings.text }}</p>
</div>
{%- endif -%}
{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p><strong>September Sale</strong> — 20% off every pack of The Blamp™ &nbsp;|&nbsp; 30-day returns</p>" }
  ]
}
{% endschema %}
