{%- comment -%}
  Product buy box. On the home page it shows the picked product (or the first
  product in the store); on a product page it shows that page's product.
  With no product in the store yet, it previews The Blamp from the theme's own
  images and the preview prices in the section settings.
{%- endcomment -%}
{%- assign featured = section.settings.product -%}
{%- if featured == blank and template.name == 'product' -%}{%- assign featured = product -%}{%- endif -%}
{%- if featured == blank -%}{%- assign featured = collections.all.products.first -%}{%- endif -%}
{%- assign root = routes.root_url -%}
{%- assign pack_max = section.settings.pack_max | default: 3 -%}

<section class="product" id="shop" aria-labelledby="product-title-{{ section.id }}">
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <ol class="breadcrumb__list">
      <li><a href="{{ root }}">Home</a></li>
      <li><a href="{{ root }}#shop">Shop</a></li>
      <li aria-current="page">{{ featured.title | default: 'The Blamp™' }}</li>
    </ol>
  </nav>

  <div class="plp-header">
    <h2 class="plp-header__title">{{ section.settings.heading }}</h2>
    {%- if section.settings.intro != blank -%}<p class="plp-header__intro">{{ section.settings.intro }}</p>{%- endif -%}
  </div>

  <div class="plp-toolbar" aria-label="Product list tools">
    <span class="plp-toolbar__filter">Filter</span>
    <span class="plp-toolbar__count">1 product</span>
    <span class="plp-toolbar__sort">Sort by: <strong>Featured</strong></span>
  </div>

  {%- if featured == blank -%}
  {%- comment -%} ---------- Preview (no product in the store yet) ---------- {%- endcomment -%}
  {%- assign preview_prices = section.settings.preview_prices | default: '19.99,29.99,34.99' | split: ',' -%}
  {%- assign preview_price = preview_prices[0] | strip | times: 100 | round -%}
  {%- assign preview_compare = section.settings.preview_compare | default: '0' | times: 100 | round -%}
  {%- assign saving = preview_compare | minus: preview_price -%}
  {%- assign saving_pct = saving | times: 100.0 | divided_by: preview_compare | round -%}
  {%- assign preview_images = 'pdp-01-front,pdp-03-glow,lifestyle-01,lifestyle-02,lifestyle-03,pdp-04-in-bag,pdp-05-everyday,pdp-06-touch,pdp-07-usb-c,pdp-02-size,pdp-09-box,pdp-08-packs,pdp-10-gift' | split: ',' -%}
  <div class="product__layout">
    <div class="product__gallery">
      <div class="product-tile">
        {%- if saving > 0 -%}<span class="product-tile__badge">Sale · Save {{ saving_pct }}%</span>{%- endif -%}
        <button class="product-tile__wishlist" data-wishlist-toggle aria-pressed="false" aria-label="Add The Blamp to wishlist">{% render 'icon', icon: 'heart' %}</button>
        <figure class="product-tile__image"><img id="product-main-image" src="{{ 'pdp-01-front.jpg' | asset_url }}" alt="The Blamp™ heart-shaped keyring light" width="1200" height="1200"></figure>
      </div>
      <ul class="product__thumbs" aria-label="Product images">
        {%- for name in preview_images -%}
          {%- assign full = name | append: '.jpg' -%}{%- assign thumb = name | append: '-thumb.jpg' -%}
          <li><button class="product__thumb{% if forloop.first %} is-active{% endif %}" type="button" data-image="{{ full | asset_url }}" data-alt="The Blamp™"><img src="{{ thumb | asset_url }}" alt="" width="120" height="120" loading="lazy"></button></li>
        {%- endfor -%}
      </ul>
    </div>
    <div class="product__details">
      <div class="product-title">
        <h3 class="product-title__name" id="product-title-{{ section.id }}">The Blamp™</h3>
        {%- if section.settings.strapline != blank -%}<p class="product-title__description">{{ section.settings.strapline }}</p>{%- endif -%}
        <p class="product-title__price">
          <span class="price price--now" data-unit-price="{{ preview_price }}">{{ preview_price | money }}</span>
          {%- if saving > 0 -%}<span class="was-price">{{ preview_compare | money }}</span><span class="price__saving">Save {{ saving | money }}</span>{%- endif -%}
        </p>
      </div>
      {%- if section.settings.offer_message != blank -%}<p class="product-promo-msg">{{ section.settings.offer_message }}</p>{%- endif -%}
      <div class="product-colour">
        <span class="product-colour__label">Colour: <strong>{{ section.settings.colour_name }}</strong></span>
        <ul class="product-colour__swatches"><li><span class="swatch swatch--selected" style="--swatch:{{ section.settings.colour_hex }}"></span></li></ul>
      </div>
      <div class="product-add">
        {% render 'heart-picker', section: section, pack_max: pack_max, with_name: false, preview_prices: preview_prices %}
        {% render 'pack-table', pack_max: pack_max, preview_prices: preview_prices %}
        <button class="btn btn--primary" type="button" data-add-to-bag disabled>Add To Bag</button>
        <p class="product-add__hint">Ordering opens as soon as the product is added in Shopify Admin (Products → Add product).</p>
      </div>
      {% render 'buy-box-tail', section: section, featured: featured %}
    </div>
  </div>

  {%- else -%}
  {%- comment -%} ---------- Live product ---------- {%- endcomment -%}
  {%- assign variant = featured.selected_or_first_available_variant -%}
  {%- assign on_sale = false -%}
  {%- if variant.compare_at_price > variant.price -%}
    {%- assign on_sale = true -%}
    {%- assign saving = variant.compare_at_price | minus: variant.price -%}
    {%- assign saving_pct = saving | times: 100.0 | divided_by: variant.compare_at_price | round -%}
  {%- endif -%}
  <div class="product__layout">
    <div class="product__gallery">
      <div class="product-tile">
        {%- if on_sale -%}<span class="product-tile__badge">Sale · Save {{ saving_pct }}%</span>{%- endif -%}
        <button class="product-tile__wishlist" data-wishlist-toggle aria-pressed="false" aria-label="Add {{ featured.title | escape }} to wishlist">{% render 'icon', icon: 'heart' %}</button>
        <figure class="product-tile__image">
          {%- if featured.featured_image != blank -%}
            {%- assign main_alt = featured.featured_image.alt | default: featured.title -%}
            {{ featured.featured_image | image_url: width: 1200 | image_tag: id: 'product-main-image', loading: 'eager', alt: main_alt }}
          {%- else -%}
            <img id="product-main-image" src="{{ 'pdp-01-front.jpg' | asset_url }}" alt="{{ featured.title | escape }}" width="1200" height="1200">
          {%- endif -%}
        </figure>
      </div>
      {%- if featured.images.size > 1 -%}
      <ul class="product__thumbs" aria-label="Product images">
        {%- for image in featured.images -%}
          <li><button class="product__thumb{% if forloop.first %} is-active{% endif %}" type="button" data-image="{{ image | image_url: width: 1200 }}" data-alt="{{ image.alt | default: featured.title | escape }}">{{ image | image_url: width: 240 | image_tag: loading: 'lazy', alt: '' }}</button></li>
        {%- endfor -%}
      </ul>
      {%- endif -%}
    </div>

    <div class="product__details">
      <div class="product-title">
        <h3 class="product-title__name" id="product-title-{{ section.id }}">{{ featured.title }}</h3>
        {%- if section.settings.strapline != blank -%}<p class="product-title__description">{{ section.settings.strapline }}</p>{%- endif -%}
        <p class="product-title__price">
          <span class="price price--now" data-unit-price="{{ variant.price }}" data-price-now>{{ variant.price | money }}</span>
          <span class="was-price" data-price-was{% unless on_sale %} hidden{% endunless %}>{% if on_sale %}{{ variant.compare_at_price | money }}{% endif %}</span>
          <span class="price__saving" data-price-saving{% unless on_sale %} hidden{% endunless %}>{% if on_sale %}Save {{ saving | money }}{% endif %}</span>
        </p>
        {%- if featured.has_only_default_variant == false -%}<p class="product-title__pack" data-pack-title>{{ variant.title }}</p>{%- endif -%}
      </div>

      {%- if section.settings.offer_message != blank -%}<p class="product-promo-msg">{{ section.settings.offer_message }}</p>{%- endif -%}

      <div class="product-colour">
        <span class="product-colour__label">Colour: <strong>{{ section.settings.colour_name }}</strong></span>
        <ul class="product-colour__swatches"><li><span class="swatch swatch--selected" style="--swatch:{{ section.settings.colour_hex }}" title="{{ section.settings.colour_name | escape }}"></span></li></ul>
      </div>

      {%- form 'product', featured, class: 'product-add', data-add-form: '', data-product-id: featured.id -%}
        <input type="hidden" name="id" value="{{ variant.id }}" data-variant-id>
        <script type="application/json" data-variants>{{ featured.variants | json }}</script>
        {% render 'heart-picker', section: section, pack_max: pack_max, with_name: true, featured: featured %}
        {% render 'pack-table', pack_max: pack_max, featured: featured %}
        <button class="btn btn--primary" type="submit" data-add-to-bag{% unless variant.available %} disabled{% endunless %}>{% if variant.available %}Add To Bag{% else %}Sold Out{% endif %}</button>
        {%- if section.settings.show_bundle_button and settings.bxgy_enabled and featured.has_only_default_variant and variant.available -%}
          {%- assign bundle_qty = settings.offer_buy | plus: settings.offer_free -%}
          <button class="btn btn--secondary" type="button" data-add-bundle data-bundle-qty="{{ bundle_qty }}">Add {{ bundle_qty }} &amp; Get {{ settings.offer_free }} Free</button>
        {%- endif -%}
      {%- endform -%}

      {% render 'buy-box-tail', section: section, featured: featured %}
    </div>
  </div>
  {%- endif -%}
</section>
{% schema %}
{
  "name": "Product buy box",
  "settings": [
    { "type": "product", "id": "product", "label": "Product", "info": "Defaults to the page's product, or your first product." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Blamp™ Bag Lamp" },
    { "type": "textarea", "id": "intro", "label": "Intro", "default": "One product. One job. A heart-shaped light that clips to any bag. Tap once and it glows: find your keys, light your step at the door, and see everything in your bag without a fumble." },
    { "type": "text", "id": "strapline", "label": "Strapline under the product name", "default": "Heart-shaped bag light · Touch control · USB-C rechargeable" },
    { "type": "text", "id": "offer_message", "label": "Offer message", "default": "One for £19.99, two for £29.99, or three for £34.99 — pick your pack below." },
    { "type": "text", "id": "colour_name", "label": "Colour name (single-variant products)", "default": "White" },
    { "type": "color", "id": "colour_hex", "label": "Colour swatch", "default": "#ffffff" },
    { "type": "text", "id": "pack_label", "label": "Pack picker label", "default": "Choose your pack" },
    { "type": "range", "id": "pack_max", "label": "Number of hearts", "min": 2, "max": 8, "step": 1, "default": 3 },
    { "type": "text", "id": "pack_caption", "label": "Pack picker caption", "default": "Tap a heart to choose your pack." },
    { "type": "checkbox", "id": "show_bundle_button", "label": "Show the bundle button (quantity mode only)", "default": false },
    { "type": "textarea", "id": "usps", "label": "Reasons to buy (one per line)", "default": "Free UK delivery on every order\n30-day returns, no questions asked\n2-year warranty" },
    { "type": "header", "content": "Preview (before a product exists)" },
    { "type": "text", "id": "preview_prices", "label": "Preview pack prices, comma separated", "default": "19.99,29.99,34.99" },
    { "type": "text", "id": "preview_compare", "label": "Preview was-price for one Blamp (blank for none)", "default": "29.99" }
  ],
  "blocks": [
    {
      "type": "accordion",
      "name": "Accordion row",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Details" },
        { "type": "checkbox", "id": "use_description", "label": "Use the product description", "default": false },
        { "type": "richtext", "id": "content", "label": "Content" },
        { "type": "checkbox", "id": "open", "label": "Open by default", "default": false }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product buy box",
      "blocks": [
        { "type": "accordion", "settings": { "title": "Details", "open": true, "content": "<p>The Blamp™ is a heart-shaped keyring light in durable ABS. Tap it once to turn it on or off, hold it for 16 seconds to keep the light on, and choose from three brightness levels.</p><ul><li>Heart 5.3 cm × 5.3 cm · chain 13 cm · 25 g</li><li>USB-C rechargeable: 1.5 hour charge, up to 10 hours on high, up to 300 charges</li><li>Splash resistant · safe for kids and pets</li><li>In the box: The Blamp™, drawstring pouch, USB-C cable, user manual</li></ul>" } },
        { "type": "accordion", "settings": { "title": "Delivery & Returns", "content": "<p>Free standard UK delivery (2–4 working days). Next-day delivery available at checkout. Not for you? Return it within 30 days for a full refund.</p>" } },
        { "type": "accordion", "settings": { "title": "About The Packs", "content": "<p>One Blamp is £19.99. Two are £29.99 and three are £34.99, so a three pack works out at under £12 each. Choose your pack with the hearts and the price updates before you add to bag.</p>" } }
      ]
    }
  ]
}
{% endschema %}
