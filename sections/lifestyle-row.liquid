<section class="product-blocks product-blocks--section" aria-labelledby="product-blocks-title-{{ section.id }}">
  <div class="section-heading">
    {%- if section.settings.eyebrow != blank -%}<p class="section-heading__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h3 class="section-heading__title product-blocks__title" id="product-blocks-title-{{ section.id }}">{{ section.settings.heading }}</h3>
  </div>
  <ul class="product-blocks__grid">
    {%- for block in section.blocks -%}
      <li class="product-blocks__item" {{ block.shopify_attributes }}>
        <figure class="product-blocks__media">
          {%- if block.settings.image != blank -%}
            {%- assign photo_alt = block.settings.image.alt | default: block.settings.title -%}
            {{ block.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', alt: photo_alt }}
          {%- elsif block.settings.fallback != blank -%}
            <img src="{{ block.settings.fallback | asset_url }}" alt="{{ block.settings.title | escape }}" width="1200" height="1200" loading="lazy">
          {%- endif -%}
        </figure>
        <p class="product-blocks__caption"><strong>{{ block.settings.title }}</strong> {{ block.settings.text }}</p>
      </li>
    {%- endfor -%}
  </ul>
</section>
{% schema %}
{
  "name": "Lifestyle row",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Inside every bag" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Light exactly where you need it" }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "Photo",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "fallback", "label": "Built-in image file (used when no image is picked)", "info": "lifestyle-01.jpg, lifestyle-02.jpg or lifestyle-03.jpg" },
        { "type": "text", "id": "title", "label": "Title", "default": "The evening bag." },
        { "type": "text", "id": "text", "label": "Caption", "default": "One tap and the lipstick, keys and phone are right there." }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "Lifestyle row",
      "blocks": [
        { "type": "photo", "settings": { "fallback": "lifestyle-01.jpg", "title": "The evening bag.", "text": "One tap and the lipstick, keys and phone are right there." } },
        { "type": "photo", "settings": { "fallback": "lifestyle-02.jpg", "title": "The everyday tote.", "text": "Clips to the inside ring and stays out of the way until you need it." } },
        { "type": "photo", "settings": { "fallback": "lifestyle-03.jpg", "title": "The work bag.", "text": "Soft, glare-free light that finds the card at the bottom of the bag." } }
      ]
    }
  ]
}
{% endschema %}
