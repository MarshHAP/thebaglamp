<section class="faqs" id="faqs" aria-labelledby="faqs-title-{{ section.id }}">
  <div class="section-heading">
    {%- if section.settings.eyebrow != blank -%}<p class="section-heading__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h2 class="section-heading__title" id="faqs-title-{{ section.id }}">{{ section.settings.heading }}</h2>
  </div>
  <div class="accordion faqs__accordion" data-accordion>
    {%- for block in section.blocks -%}
      <div class="accordion-navigation" {{ block.shopify_attributes }}>
        <button class="accordion__trigger" aria-expanded="false" aria-controls="faq-{{ block.id }}">{{ block.settings.question }}</button>
        <div class="accordion__content" id="faq-{{ block.id }}" hidden>{{ block.settings.answer }}</div>
      </div>
    {%- endfor -%}
  </div>
</section>
{% schema %}
{
  "name": "FAQs",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Customer care" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Frequently Asked Questions" }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "How do the packs work?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>One Blamp is £19.99, two are £29.99 and three are £34.99.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQs",
      "blocks": [
        { "type": "faq", "settings": { "question": "How do the packs work?", "answer": "<p>One Blamp is £19.99. Two are £29.99 and three are £34.99, so a three pack works out at under £12 each. Tap a heart on the product page to choose your pack.</p>" } },
        { "type": "faq", "settings": { "question": "How long does the battery last?", "answer": "<p>Up to 10 hours on the highest brightness, and longer on the lower two. A full charge takes about 90 minutes over USB-C, and the battery is good for up to 300 charges.</p>" } },
        { "type": "faq", "settings": { "question": "Will it fit my bag?", "answer": "<p>Yes. The lobster clasp clips to any ring, zip pull or strap, and at 25 g and 5.3 cm across it sits happily on a micro bag, a clutch, a backpack or a pet collar.</p>" } },
        { "type": "faq", "settings": { "question": "How do I turn it on and off?", "answer": "<p>Tap the heart once to turn it on, and once more to turn it off. Hold it for 16 seconds to keep the light on, and tap to cycle through three brightness levels.</p>" } },
        { "type": "faq", "settings": { "question": "What is your delivery and returns policy?", "answer": "<p>Standard UK delivery is free and takes 2–4 working days. If you change your mind, return it within 30 days for a full refund.</p>" } },
        { "type": "faq", "settings": { "question": "Is The Blamp covered by a warranty?", "answer": "<p>Every Blamp comes with a two-year warranty covering the battery, the touch switch and the clasp.</p>" } },
        { "type": "faq", "settings": { "question": "Is it safe for children and pets?", "answer": "<p>Yes. The shell is durable ABS with no sharp edges, it is splash resistant, and there are no small removable parts.</p>" } }
      ]
    }
  ]
}
{% endschema %}
